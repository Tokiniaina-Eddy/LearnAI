# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=LearnAI
APP_ENV=development
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://learnai:learnai@localhost:5432/learnai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
OPENAI_RATE_LIMIT_PER_HOUR=100

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Mettre SMTP_ENABLED=true pour activer l'envoi réel
# En développement : SMTP_ENABLED=false → le code OTP est affiché dans les logs
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application
SMTP_FROM_NAME=LearnAI
SMTP_FROM_EMAIL=noreply@learnai.dev

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESEND_PER_HOUR=5

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Créer un projet sur https://console.cloud.google.com
# → API & Services → Identifiants → Créer des identifiants → ID client OAuth 2.0
# URI de redirection autorisée : http://localhost:8000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
