# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=LearnAI
APP_ENV=development
SECRET_KEY=change_me_to_a_long_random_string_at_least_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://learnai:learnai@localhost:5432/learnai

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
OPENAI_RATE_LIMIT_PER_HOUR=100
